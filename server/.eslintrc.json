{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-process-exit": "off",
    "prefer-const": "warn",
    "eqeqeq": ["error", "always"]
  },
  "ignorePatterns": ["node_modules/", "dist/", "build/"]
}